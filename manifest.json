{
  "manifest_version": 3,
  "name": "Canva Video Automator (Side Panel)",
  "version": "3.2",
  "description": "Panneau latéral (Side Panel) pour ajouter des vidéos Nature (50 min), supprimer audio/animations et émettre un son sur Canva.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.canva.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.canva.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ouvrir Canva Automator (Side Panel)"
  }
}
